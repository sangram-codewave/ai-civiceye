# Public browser values. Safe to expose. Never put secrets behind a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Used by Vercel functions and npm run seed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used only by `npm run seed`. Never commit real passwords.
# Omit these in production.
DEMO_CITIZEN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_OFFICER_PASSWORD=

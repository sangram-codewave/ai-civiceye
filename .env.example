# Shared by the browser and the API. Vite inlines only these two.
# Do not prefix them with VITE_. Vercel rejects visibility "secret" for that prefix,
# and a SUPABASE_ env prefix would also expose the service role key to the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Used by Vercel functions and npm run seed.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used only by `npm run seed`. Never commit real passwords.
# Omit these in production.
DEMO_CITIZEN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_OFFICER_PASSWORD=
